{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://slotstream.local/schemas/flash/quality-metrics-v2.json",
  "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"aggregate":{"type":"object","additionalProperties":false,"required":["tokens","meanKL","p99KL","minimumRawKL","toleratedNegativeRows","top1Agreement","referenceMeanNLL","candidateMeanNLL","pplRatio"],"properties":{"tokens":{"type":"integer","minimum":1},"meanKL":{"type":"number","minimum":0},"p99KL":{"type":"number","minimum":0},"minimumRawKL":{"type":"number"},"toleratedNegativeRows":{"type":"integer","minimum":0},"top1Agreement":{"type":"number","minimum":0,"maximum":1},"referenceMeanNLL":{"type":"number"},"candidateMeanNLL":{"type":"number"},"pplRatio":{"type":"number","exclusiveMinimum":0}}}},
  "type":"object","additionalProperties":false,
  "required":["format","schemaVersion","qualification","cohortKind","diagnosticControl","referenceIndexSHA256","candidateIndexSHA256","allowedIdentityDifferences","rows","rowIdentitySHA256","pooled","categories","bootstrap","negativeKLRoundoffBand","thresholds","overallQualification","unavailable","runtime","qualityHarnessHashes"],
  "properties":{
    "format":{"const":"slotstream-quality-metrics-v2"},"schemaVersion":{"const":2},"qualification":{"const":false},"overallQualification":{"const":false},
    "cohortKind":{"enum":["full-study","diagnostic-control"]},"diagnosticControl":{"type":"boolean"},
    "referenceIndexSHA256":{"$ref":"#/$defs/hash"},"candidateIndexSHA256":{"$ref":"#/$defs/hash"},
    "allowedIdentityDifferences":{"type":"array","items":{"enum":["mode","binarySHA256","sourceArchiveSHA256","buildIdentitySHA256","metallibSHA256","executionHarnessSHA256","runtimeControls"]},"uniqueItems":true},
    "rows":{"type":"integer","minimum":1},"rowIdentitySHA256":{"$ref":"#/$defs/hash"},"pooled":{"$ref":"#/$defs/aggregate"},
    "categories":{"type":"object","minProperties":1,"additionalProperties":{"$ref":"#/$defs/aggregate"}},
    "bootstrap":{"type":"object"},"negativeKLRoundoffBand":{"type":"object"},"thresholds":{"type":"object"},
    "unavailable":{"type":"array","minItems":1,"items":{"type":"string"},"uniqueItems":true},"runtime":{"type":"object"},"qualityHarnessHashes":{"type":"object","minProperties":1,"additionalProperties":{"$ref":"#/$defs/hash"}}
  }
}
