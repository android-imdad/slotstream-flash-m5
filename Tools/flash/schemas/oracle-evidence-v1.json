{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "config_sha256",
    "study_sha256",
    "suite_sha256",
    "norm_manifest_sha256",
    "algorithm",
    "retained_blocks",
    "diagnostic_reserved_bytes",
    "norm_payload_bytes",
    "warmup_policy",
    "mask_failure_state_reuse_refused",
    "mask_files"
  ],
  "properties": {
    "format": {
      "const": "slotstream-oracle-evidence-v1"
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "study_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "suite_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "norm_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "algorithm": {
      "const": "fp32-values-fp64-sequential-column-l2-block64-v1"
    },
    "retained_blocks": {
      "enum": [
        10,
        8,
        6,
        4,
        2
      ]
    },
    "diagnostic_reserved_bytes": {
      "const": 218103808
    },
    "norm_payload_bytes": {
      "const": 62914560
    },
    "warmup_policy": {
      "const": "dense-whole-document"
    },
    "mask_failure_state_reuse_refused": {
      "const": true
    },
    "mask_files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "document_id",
          "token_position",
          "bytes",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^oracle-mask-[0-9]{3}\\.json$"
          },
          "document_id": {
            "type": "string"
          },
          "token_position": {
            "type": "integer",
            "minimum": 0
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 131072
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
