{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "artifactIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {"path": {"enum": ["tokenizer.json", "tokenizer_config.json", "config.json"]}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "tokenizerIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["model_revision", "swift_transformers_revision", "files", "embedded_chat_template_sha256", "text_add_special_tokens", "thinking"],
      "properties": {
        "model_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "swift_transformers_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "files": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/artifactIdentity"}},
        "embedded_chat_template_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "text_add_special_tokens": {"const": false},
        "thinking": {"const": false}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "manifestSHA256", "tokenSource", "split", "sourceCorpusSHA256", "tokenizerIdentity", "shardID", "documents"],
  "properties": {
    "format": {"const": "slotstream-tokenized-capture-shard-v2"},
    "schemaVersion": {"const": 2},
    "manifestSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tokenSource": {"const": "slotstream-auto-tokenizer-chat-template-v1"},
    "split": {"enum": ["training", "development", "qualification"]},
    "sourceCorpusSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tokenizerIdentity": {"$ref": "#/$defs/tokenizerIdentity"},
    "shardID": {"type": "string", "pattern": "^shard-[0-9]{3,4}$"},
    "documents": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "category", "sourceID", "sourceHash", "split", "warmupIDs", "positions"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
          "category": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
          "sourceID": {"type": "string", "minLength": 1, "maxLength": 256},
          "sourceHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "split": {"enum": ["training", "development", "qualification"]},
          "warmupIDs": {"type": "array", "maxItems": 256, "items": {"type": "integer", "minimum": 0, "maximum": 248319}},
          "positions": {
            "type": "array", "minItems": 1, "maxItems": 64,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["position", "inputID", "nextTokenID"],
              "properties": {
                "position": {"type": "integer", "minimum": 0, "maximum": 2047},
                "inputID": {"type": "integer", "minimum": 0, "maximum": 248319},
                "nextTokenID": {"type": "integer", "minimum": 0, "maximum": 248319}
              }
            }
          }
        }
      }
    }
  }
}
