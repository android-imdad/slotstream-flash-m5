{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "metadata": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "kind", "category", "split", "sourceID", "license", "partitionKey", "textSHA256"],
          "properties": {
            "id": {"$ref": "#/$defs/id"}, "kind": {"const": "raw"}, "category": {"$ref": "#/$defs/id"},
            "split": {"enum": ["training", "development", "qualification"]},
            "sourceID": {"type": "string"}, "license": {"type": "string"}, "partitionKey": {"type": "string"},
            "textSHA256": {"$ref": "#/$defs/hash"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "kind", "category", "split", "sourceID", "license", "partitionKey", "contentSHA256"],
          "properties": {
            "id": {"$ref": "#/$defs/id"}, "kind": {"const": "chat"}, "category": {"$ref": "#/$defs/id"},
            "split": {"enum": ["training", "development", "qualification"]},
            "sourceID": {"type": "string"}, "license": {"type": "string"}, "partitionKey": {"type": "string"},
            "contentSHA256": {"$ref": "#/$defs/hash"}
          }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "sourceDocument", "promptIDs", "promptCount", "promptIDsSHA256"],
  "properties": {
    "format": {"const": "slotstream-tokenized-prompt-v1"},
    "schemaVersion": {"const": 1},
    "sourceDocument": {"$ref": "#/$defs/metadata"},
    "promptIDs": {"type": "array", "minItems": 1, "maxItems": 8192, "items": {"type": "integer", "minimum": 0, "maximum": 248319}},
    "promptCount": {"type": "integer", "minimum": 1, "maximum": 8192},
    "promptIDsSHA256": {"$ref": "#/$defs/hash"}
  }
}
