{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "common": {
      "id": {"$ref": "#/$defs/id"},
      "category": {"$ref": "#/$defs/id"},
      "split": {"enum": ["training", "development", "qualification"]},
      "sourceID": {"type": "string", "minLength": 1, "maxLength": 256},
      "license": {"type": "string", "minLength": 1, "maxLength": 256},
      "partitionKey": {"type": "string", "minLength": 1, "maxLength": 256}
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "manifestSHA256", "documents"],
  "properties": {
    "format": {"const": "slotstream-prompt-source-v1"},
    "schemaVersion": {"const": 1},
    "manifestSHA256": {"$ref": "#/$defs/hash"},
    "documents": {
      "type": "array", "minItems": 1, "maxItems": 2048,
      "items": {
        "oneOf": [
          {
            "type": "object", "additionalProperties": false,
            "required": ["id", "kind", "category", "split", "sourceID", "license", "partitionKey", "text", "textSHA256"],
            "properties": {
              "id": {"$ref": "#/$defs/id"}, "kind": {"const": "raw"},
              "category": {"$ref": "#/$defs/id"},
              "split": {"enum": ["training", "development", "qualification"]},
              "sourceID": {"type": "string", "minLength": 1, "maxLength": 256},
              "license": {"type": "string", "minLength": 1, "maxLength": 256},
              "partitionKey": {"type": "string", "minLength": 1, "maxLength": 256},
              "text": {"type": "string", "minLength": 1, "maxLength": 32768},
              "textSHA256": {"$ref": "#/$defs/hash"}
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["id", "kind", "category", "split", "sourceID", "license", "partitionKey", "system", "user", "contentSHA256"],
            "properties": {
              "id": {"$ref": "#/$defs/id"}, "kind": {"const": "chat"},
              "category": {"$ref": "#/$defs/id"},
              "split": {"enum": ["training", "development", "qualification"]},
              "sourceID": {"type": "string", "minLength": 1, "maxLength": 256},
              "license": {"type": "string", "minLength": 1, "maxLength": 256},
              "partitionKey": {"type": "string", "minLength": 1, "maxLength": 256},
              "system": {"type": "string", "maxLength": 32768},
              "user": {"type": "string", "minLength": 1, "maxLength": 32768},
              "contentSHA256": {"$ref": "#/$defs/hash"}
            }
          }
        ]
      }
    }
  }
}
