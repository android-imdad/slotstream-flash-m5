{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "manifestSHA256", "documents"],
  "properties": {
    "format": {"const": "slotstream-authored-corpus-v1"},
    "schemaVersion": {"const": 1},
    "manifestSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "documents": {
      "type": "array", "minItems": 1, "maxItems": 2048,
      "items": {
        "oneOf": [
          {
            "type": "object", "additionalProperties": false,
            "required": ["id", "kind", "category", "split", "sourceID", "license", "partitionKey", "scoreTokens", "text", "textSHA256", "warmupTokens"],
            "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"}, "kind": {"const": "raw"}, "category": {"type": "string"}, "split": {"enum": ["training", "development", "qualification"]}, "sourceID": {"type": "string"}, "license": {"type": "string"}, "partitionKey": {"type": "string"}, "scoreTokens": {"type": "integer", "minimum": 1, "maximum": 64}, "text": {"type": "string", "maxLength": 32768}, "textSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "warmupTokens": {"type": "integer", "minimum": 0, "maximum": 256}}
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["id", "kind", "category", "split", "sourceID", "license", "partitionKey", "scoreTokens", "system", "user", "reference", "contentSHA256"],
            "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"}, "kind": {"const": "chat"}, "category": {"type": "string"}, "split": {"enum": ["training", "development", "qualification"]}, "sourceID": {"type": "string"}, "license": {"type": "string"}, "partitionKey": {"type": "string"}, "scoreTokens": {"type": "integer", "minimum": 1, "maximum": 64}, "system": {"type": "string", "maxLength": 32768}, "user": {"type": "string", "minLength": 1, "maxLength": 32768}, "reference": {"type": "string", "minLength": 1, "maxLength": 32768}, "contentSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
          }
        ]
      }
    }
  }
}
