{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://slotstream.local/schemas/flash/quality-suite-v2.json",
  "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
  "type":"object","additionalProperties":false,
  "required":["format","schemaVersion","qualification","prepared","tokenized","promptTokenized","adapter","counts","finalScoredCounts","producerSnapshot","overallQualification","unavailable","manifestSHA256"],
  "properties":{
    "format":{"const":"slotstream-quality-suite-v2"},"schemaVersion":{"const":2},"qualification":{"const":false},"overallQualification":{"const":false},"manifestSHA256":{"$ref":"#/$defs/hash"},
    "prepared":{"type":"object","additionalProperties":false,"required":["path","suiteSHA256","teacherCorpusSHA256","scoredPromptsSHA256","contractSHA256"],"properties":{"path":{"type":"string"},"suiteSHA256":{"$ref":"#/$defs/hash"},"teacherCorpusSHA256":{"$ref":"#/$defs/hash"},"scoredPromptsSHA256":{"$ref":"#/$defs/hash"},"contractSHA256":{"$ref":"#/$defs/hash"}}},
    "tokenized":{"type":"object","additionalProperties":false,"required":["path","corpusSHA256","completionSHA256","documents","positions","tokenizerIdentity"],"properties":{"path":{"type":"string"},"corpusSHA256":{"$ref":"#/$defs/hash"},"completionSHA256":{"$ref":"#/$defs/hash"},"documents":{"type":"integer","minimum":1},"positions":{"type":"integer","minimum":1},"tokenizerIdentity":{"type":"object"}}},
    "adapter":{"type":"object","additionalProperties":false,"required":["path","binarySHA256","archiveReceiptSHA256"],"properties":{"path":{"type":"string"},"binarySHA256":{"$ref":"#/$defs/hash"},"archiveReceiptSHA256":{"$ref":"#/$defs/hash"}}},
    "promptTokenized":{"type":"object"},"producerSnapshot":{"type":"object","additionalProperties":false,"required":["path","snapshotSHA256"],"properties":{"path":{"type":"string"},"snapshotSHA256":{"$ref":"#/$defs/hash"}}},
    "counts":{"type":"object"},"finalScoredCounts":{"type":"object","additionalProperties":false,"required":["gsm8k","humaneval","xnli","structured"],"properties":{"gsm8k":{"const":200},"humaneval":{"const":164},"xnli":{"const":600},"structured":{"const":200}}},
    "unavailable":{"type":"array","minItems":1,"items":{"type":"string"},"uniqueItems":true}
  }
}
